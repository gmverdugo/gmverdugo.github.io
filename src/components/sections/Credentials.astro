---
import type { Locale } from '../../i18n';
import { credentials } from '../../i18n/sections/credentials';
import { chapters } from '../../data/chapters';
import Chapter from '../ui/Chapter.astro';
import LedgerRow from '../ui/LedgerRow.astro';
import Badge from '../ui/Badge.astro';
import StatusLine from '../ui/StatusLine.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = credentials[locale];
---

<Chapter
  id={chapters.credentials.id}
  index={chapters.credentials.index}
  tag={t.tag}
  title={t.title}
  intro={t.intro}
  rail={[t.rail.credentials, t.rail.career]}
>
  <div class="flex flex-col gap-14">
    <div>
      <p class="label-mono text-muted">{t.featured.label}</p>
      <div class="mt-4 border-l-2 border-l-signal bg-plate p-6 md:p-8">
        <StatusLine loose>{t.featured.status}</StatusLine>
        <h3 class="mt-5 font-serif text-3xl leading-tight tracking-tight text-ink md:text-title">{t.featured.name}</h3>
        <p class="label-mono mt-3 text-muted">{t.featured.issuer}</p>
        <p class="mt-4 max-w-[60ch] text-muted">{t.featured.note}</p>
      </div>
    </div>

    <div>
      <p class="label-mono mb-4 text-muted">{t.secondaryLabel}</p>
      <ul role="list" class="m-0 flex list-none flex-col p-0">
        {t.secondary.map((c) => (
          <li class="-mt-px">
            <LedgerRow>
              <div class="grid gap-2 md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-8">
                <div>
                  <p class="font-serif text-xl text-ink">{c.name}</p>
                  <p class="label-mono mt-1 text-muted">
                    {c.issuer}
                    {c.period && <span> / {c.period}</span>}
                  </p>
                </div>
                <Badge>{c.kind}</Badge>
              </div>
            </LedgerRow>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="label-mono mb-6 text-muted">{t.careerLabel}</p>
      <ol role="list" class="relative m-0 flex list-none flex-col gap-10 border-l border-rule-strong p-0 pl-6 md:pl-10">
        {t.career.map((r) => (
          <li class="relative max-w-[46rem]">
            <span
              aria-hidden="true"
              class:list={[
                'absolute -left-[29px] top-2 block size-2 rounded-full border md:-left-[45px]',
                r.current ? 'border-signal bg-signal' : 'border-muted bg-canvas',
              ]}
            />
            <div class="grid gap-1 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-baseline lg:gap-8">
              <h3 class="font-serif text-2xl leading-snug text-ink">{r.role}</h3>
              <p class="label-mono text-muted">{r.period}</p>
            </div>
            <p class="label-mono mt-1 text-signal">{r.org}</p>
            <p class="mt-4 max-w-measure text-ink">{r.summary}</p>
            <ul
              role="list"
              class="m-0 mt-4 flex max-w-measure list-none flex-col gap-2 p-0 border-t border-rule pt-4 text-muted"
            >
              {r.points.map((p) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-3 block h-px w-3 shrink-0 bg-rule-active" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Chapter>

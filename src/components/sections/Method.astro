---
import type { Locale } from '../../i18n';
import { method } from '../../i18n/sections/method';
import { chapters } from '../../data/chapters';
import Chapter from '../ui/Chapter.astro';
import NumberedList from '../ui/NumberedList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = method[locale];
---

<Chapter
  id={chapters.method.id}
  index={chapters.method.index}
  tag={t.tag}
  title={t.title}
  intro={t.intro}
  rail={t.rail}
>
  <NumberedList items={t.items} variant="grid" />
</Chapter>

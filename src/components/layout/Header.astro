---
import { anchor, homePath, locales, pad2, type Locale } from '../../i18n';
import { nav } from '../../i18n/sections/nav';
import { site } from '../../data/site';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = nav[locale];
const link =
  'label-mono inline-flex min-h-6 items-center text-muted transition-colors duration-150 hover:text-ink focus-visible:text-ink';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-rule bg-canvas">
  <Container class="flex flex-wrap items-center gap-x-6">
    <div class="flex h-11 items-center gap-4">
      <a
        href={homePath(locale)}
        aria-label={t.homeLabel}
        class="inline-flex min-h-6 items-center font-serif text-xl tracking-tight text-ink"
      >
        {t.monogram}
      </a>
    </div>

    {/* Always two rows: the full row (brand + 8 links + links) needs ~1360px, more than the 1440px container leaves. The nav scrolls on its own row; the mask hints there is more. */}
    <nav
      aria-label={t.navLabel}
      class="order-last -mx-6 flex h-10 w-[calc(100%+3rem)] items-center overflow-x-auto border-t border-rule px-6 py-1 [mask-image:linear-gradient(to_right,black_calc(100%-3.5rem),transparent)] md:-mx-margin md:w-[calc(100%+6rem)] md:px-margin"
    >
      <ul role="list" class="flex list-none items-center gap-5 whitespace-nowrap">
        {t.links.map((item, i) => (
          <li>
            <a href={anchor(locale, item.id)} class={link}>
              <span class="text-signal">{pad2(i + 1)}</span>&nbsp;{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex h-11 items-center gap-5">
      <ul role="list" class="flex list-none items-center gap-2" aria-label={t.languageLabel}>
        {locales.map((l, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && (
              <span aria-hidden="true" class="text-rule-active">
                |
              </span>
            )}
            <a
              href={homePath(l)}
              lang={l}
              hreflang={l}
              aria-label={t.languages[l]}
              aria-current={l === locale ? 'page' : undefined}
              class:list={[link, 'min-w-6 justify-center', l === locale && 'text-ink underline underline-offset-4']}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
      <a href={site.linkedin} rel="noopener noreferrer" class={link}>
        {t.linkedinLabel}
      </a>
      <a href={`mailto:${site.email}`} class:list={[link, 'hidden sm:inline-flex']}>
        {t.emailLabel}
      </a>
    </div>
  </Container>
</header>

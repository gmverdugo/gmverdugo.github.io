---
import ConsoleShell from './ConsoleShell.astro';
import Chip from '../components/Chip.astro';
import { getLocale, t } from '../i18n';

/**
 * Case-study inner-page layout: header (crumbs/title/tags) + cs-grid
 * (body + sticky cs-rail). Section order is fixed: Challenge,
 * Architecture, Implementation, Stack, Results, Lessons learned.
 * Rail hides <760px (sections remain reachable by scroll).
 */
interface Props {
  breadcrumb: string;
  crumbsLabel: string;
  title: string;
  dek: string;
  tags: string[];
  dataIntegrity: 'verified' | 'illustrative';
}

const { breadcrumb, crumbsLabel, title, dek, tags, dataIntegrity } = Astro.props;

const locale = getLocale(Astro.url.pathname);
const s = t(locale);

const backHref = '/case-studies';
const backLabel = s.nav.caseStudies;

const railLinks = [
  { href: '#challenge', label: 'Challenge' },
  { href: '#architecture', label: 'Architecture' },
  { href: '#implementation', label: 'Implementation' },
  { href: '#stack', label: 'Stack' },
  { href: '#results', label: 'Results' },
  { href: '#lessons', label: 'Lessons learned' },
];
---

<ConsoleShell title={title} breadcrumb={breadcrumb} description={dek} backHref={backHref} backLabel={backLabel}>
  <div class="cs-head">
    <div class="crumbs">{crumbsLabel}</div>
    <h1>{title}</h1>
    <p class="dim" style="max-width:720px">{dek}</p>
    <div class="tags">
      <Chip variant={dataIntegrity === 'verified' ? 'real' : 'illustrative'}>
        {dataIntegrity === 'verified' ? 'verified outcomes' : 'illustrative'}
      </Chip>
      {tags.map((tag: string) => <Chip variant="mono">{tag}</Chip>)}
    </div>
  </div>

  <div class="cs-grid">
    <div class="cs-body">
      <slot />
    </div>

    <nav class="cs-rail" aria-label={s.onThisPage}>
      <div class="label">{s.onThisPage}</div>
      {railLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</ConsoleShell>

<style>
  .cs-head {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 4px;
  }
  .cs-head .crumbs {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-fg-2);
  }
  .cs-head h1 {
    font-size: 21px;
    margin: 10px 0 8px;
  }
  .cs-head .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .cs-grid {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 28px;
  }
  .cs-rail {
    position: sticky;
    top: 60px;
    align-self: start;
    padding-top: 22px;
  }
  .cs-rail .label {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-2);
    padding-left: 12px;
    margin-bottom: 6px;
  }
  .cs-rail a {
    display: block;
    padding: 6px 0 6px 12px;
    color: var(--color-fg-1);
    font-size: 13px;
    border-left: 2px solid transparent;
  }
  .cs-rail a:hover {
    color: var(--color-fg-0);
    text-decoration: none;
  }
  .cs-rail a:focus-visible {
    color: var(--color-fg-0);
    border-left-color: var(--color-accent);
  }
  .cs-body {
    min-width: 0;
    padding-top: 22px;
  }
  @media (max-width: 760px) {
    .cs-grid {
      grid-template-columns: 1fr;
    }
    .cs-rail {
      display: none;
    }
  }
</style>

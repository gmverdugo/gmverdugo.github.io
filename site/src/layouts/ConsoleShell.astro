---
import Sidebar from '../components/Sidebar.astro';
import Statusbar from '../components/Statusbar.astro';
import { getLocale, counterpartPath, t } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  breadcrumb: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}

const { title, breadcrumb, description, backHref, backLabel } = Astro.props;

const locale = getLocale(Astro.url.pathname);
const s = t(locale);

const site = Astro.site?.toString().replace(/\/+$/, '') ?? '';
const counterpart = counterpartPath(Astro.url.pathname);
const enPath = locale === 'en' ? Astro.url.pathname : counterpart;
const esPath = locale === 'es' ? Astro.url.pathname : counterpart;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title} · Gonzalo Verdugo</title>
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="es" href={`${site}${esPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${enPath}`} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{s.skipToContent}</a>
    <div class="shell">
      <Sidebar />
      <div class="main">
        <Statusbar breadcrumb={breadcrumb} />
        <main id="main-content" class="content">
          {backHref && (
            <a href={backHref} class="back-link">← {backLabel ?? s.back}</a>
          )}
          <slot />
        </main>
      </div>
    </div>

    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      if (toggle && sidebar && backdrop) {
        const focusableSelector =
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

        function openDrawer() {
          sidebar!.classList.add('is-open');
          backdrop!.classList.add('is-open');
          toggle!.setAttribute('aria-expanded', 'true');
          const firstLink = sidebar!.querySelector<HTMLElement>(focusableSelector);
          firstLink?.focus();
          document.addEventListener('keydown', onKeydown);
        }

        function closeDrawer() {
          sidebar!.classList.remove('is-open');
          backdrop!.classList.remove('is-open');
          toggle!.setAttribute('aria-expanded', 'false');
          document.removeEventListener('keydown', onKeydown);
          toggle!.focus();
        }

        function isOpen() {
          return sidebar!.classList.contains('is-open');
        }

        function onKeydown(e: KeyboardEvent) {
          if (e.key === 'Escape') {
            closeDrawer();
            return;
          }
          if (e.key === 'Tab') {
            const focusables = Array.from(sidebar!.querySelectorAll<HTMLElement>(focusableSelector));
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }

        toggle.addEventListener('click', () => {
          if (isOpen()) {
            closeDrawer();
          } else {
            openDrawer();
          }
        });

        backdrop.addEventListener('click', closeDrawer);
      }
    </script>
  </body>
</html>

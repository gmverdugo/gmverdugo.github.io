---
/**
 * Numbered section label with a divider line, matching the mockup's
 * `.sect-label` pattern (Overview's "01 Operating footprint" style).
 */
interface Props {
  number: string;
  heading: string;
}

const { number, heading } = Astro.props;
---

<div class="sect-label">
  <span class="num">{number}</span>
  <h2>{heading}</h2>
  <span class="line"></span>
  <slot />
</div>

<style>
  .sect-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 24px 0 10px;
  }
  .sect-label .num {
    color: var(--color-fg-2);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .sect-label h2 {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-1);
  }
  .sect-label .line {
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }
</style>

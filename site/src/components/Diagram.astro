---
import BarBeforeAfter from './diagrams/BarBeforeAfter.astro';
import MaturityTracker from './diagrams/MaturityTracker.astro';
import ConsolidationBeforeAfter from './diagrams/ConsolidationBeforeAfter.astro';

/**
 * Dispatcher: switches render on diagram.type to the matching native
 * diagram component. OtelFlow is intentionally NOT dispatched here —
 * it is a fixed structural diagram (not metric-data-bound) used
 * alongside MaturityTracker on Case Study B; pages import it directly.
 */
interface Props {
  type: 'bar-before-after' | 'maturity-tracker' | 'consolidation-before-after';
  data: Record<string, any>;
  ariaLabel: string;
}

const { type, data, ariaLabel } = Astro.props;
---

{type === 'bar-before-after' && <BarBeforeAfter groups={data.groups} ariaLabel={ariaLabel} />}
{type === 'maturity-tracker' && <MaturityTracker stages={data.stages} current={data.current} max={data.max} ariaLabel={ariaLabel} />}
{
  type === 'consolidation-before-after' && (
    <ConsolidationBeforeAfter before={data.before} after={data.after} storageDelta={data.storageDelta} retentionDays={data.retentionDays} ariaLabel={ariaLabel} />
  )
}

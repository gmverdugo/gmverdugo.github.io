---
import Avatar from './Avatar.astro';
import StatusDot from './StatusDot.astro';
import { getLocale, t } from '../i18n';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(section: string): boolean {
  if (section === '/') return path === '/';
  return path === section || path.startsWith(`${section}/`);
}

const locale = getLocale(Astro.url.pathname);
const s = t(locale);

/**
 * Locale-aware href: prefixes section paths with `/es` when browsing the
 * Spanish side, so navigating from the sidebar keeps the visitor in their
 * current locale instead of silently dropping back to English. `/es/...`
 * routes 404 until the mirrored route tree lands (Phase 5) — the link
 * generation logic must still be correct now per the design's explicit
 * Sidebar locale-awareness risk note.
 */
function localeHref(section: string): string {
  if (locale === 'en') return section;
  return section === '/' ? '/es/' : `/es${section}`;
}

const workspaceLinks = [
  { href: localeHref('/'), label: s.nav.overview, badge: '⌘1', section: '/' },
  { href: localeHref('/architectures'), label: s.nav.architectures, section: '/architectures' },
  { href: localeHref('/case-studies'), label: s.nav.caseStudies, badge: '3', section: '/case-studies' },
  { href: localeHref('/lab'), label: s.nav.lab, section: '/lab' },
  { href: localeHref('/articles'), label: s.nav.articles, section: '/articles' },
];

const profileLinks = [
  { href: localeHref('/certifications'), label: s.nav.certifications, section: '/certifications' },
  { href: localeHref('/engagement-models'), label: s.nav.engagementModels, badge: '8', section: '/engagement-models' },
  { href: localeHref('/contact'), label: s.nav.contact, section: '/contact' },
];
---

<aside class="sidebar" id="sidebar">
  <div class="id">
    <Avatar initials="GV" />
    <div class="name">Gonzalo Verdugo</div>
    <div class="role">Enterprise Observability Architect</div>
  </div>
  <nav aria-label="Primary">
    <div class="group">Workspace</div>
    <ul style="list-style:none; margin:0; padding:0;">
      {
        workspaceLinks.map((link) => (
          <li>
            <a href={link.href} class={isActive(link.section) ? 'active' : undefined} aria-current={isActive(link.section) ? 'page' : undefined}>
              <span>{link.label}</span>
              {link.badge && <span class="badge">{link.badge}</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="group">Profile</div>
    <ul style="list-style:none; margin:0; padding:0;">
      {
        profileLinks.map((link) => (
          <li>
            <a href={link.href} class={isActive(link.section) ? 'active' : undefined} aria-current={isActive(link.section) ? 'page' : undefined}>
              <span>{link.label}</span>
              {link.badge && <span class="badge">{link.badge}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="foot">
    <StatusDot variant="ok" /> {s.availability}<br />
    Mendoza, AR &middot; ES / EN
  </div>
</aside>
<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

---
import Avatar from './Avatar.astro';
import Btn from './Btn.astro';

/**
 * Carried-forward validated element from the mockup — a single
 * restrained primary CTA, NOT a SaaS-style hero CTA. Reused on
 * Overview and Contact.
 */
interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Available for direct consulting engagements',
  body = 'Independent contractor — architecture advisory, platform assessments, and optimization programs. No agency, no intermediaries.',
  ctaLabel = 'Start a conversation',
  ctaHref = '/contact',
} = Astro.props;
---

<div class="contractor-card">
  <Avatar initials="GV" />
  <div class="txt">
    <b>{heading}</b>
    <p>{body}</p>
  </div>
  <Btn href={ctaHref} variant="primary">{ctaLabel}</Btn>
</div>

<style>
  .contractor-card {
    margin-top: 26px;
    background: linear-gradient(180deg, #0d1322, #0a0e18);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-base);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .contractor-card .txt {
    flex: 1;
  }
  .contractor-card .txt b {
    font-size: 14px;
  }
  .contractor-card .txt p {
    margin: 4px 0 0;
    color: var(--color-fg-1);
    font-size: 13px;
  }
  @media (max-width: 560px) {
    .contractor-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

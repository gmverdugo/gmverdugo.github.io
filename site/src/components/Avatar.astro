---
interface Props {
  initials: string;
  size?: 'default' | 'lg';
  class?: string;
}

const { initials, size = 'default', class: className } = Astro.props;
const sizeClass = size === 'lg' ? 'avatar lg' : 'avatar';
---

<div class={[sizeClass, className].filter(Boolean).join(' ')}>{initials}</div>

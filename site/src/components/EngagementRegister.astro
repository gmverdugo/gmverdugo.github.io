---
import Chip from './Chip.astro';

/**
 * Engagement register table — each row attributes one engagement's
 * own verified outcome string. No row's figure is summed, averaged,
 * or blended with another engagement's figure (site-information-
 * architecture requirement).
 */
interface Row {
  id: string;
  engagement: string;
  scope: string;
  outcome: string;
  href: string;
}

const rows: Row[] = [
  {
    id: 'A',
    engagement: 'HOT-tier optimization',
    scope: 'Sharding & heap tuning',
    outcome: '10,150 → 8,173 shards · 78 → 49 shards/GB-heap',
    href: '/case-studies/meli-hot-tier',
  },
  {
    id: 'B',
    engagement: 'Maturity assessment',
    scope: 'Obs + security, 11 domains',
    outcome: '12B+ docs · 1,459 rules · 1.8 / 4.0',
    href: '/case-studies/meli-maturity',
  },
  {
    id: 'C',
    engagement: 'Banking platform consolidation',
    scope: 'On-prem, LogsDB',
    outcome: '93 → 16 ERUs (-83%) · −30.75% storage',
    href: '/case-studies/icbc-consolidation',
  },
];
---

<table class="register">
  <thead>
    <tr>
      <th style="width:30px"></th>
      <th>Engagement</th>
      <th>Scope</th>
      <th>Verified outcome</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td class="num" style="color:var(--color-accent)">{row.id}</td>
          <td><a href={row.href}>{row.engagement}</a></td>
          <td class="dim">{row.scope}</td>
          <td class="num">{row.outcome}</td>
        </tr>
      ))
    }
  </tbody>
</table>

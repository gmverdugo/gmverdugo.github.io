---
/**
 * Single metric tile (case-study result tiles). delta.down=ok green
 * (improvement via reduction), delta.up=info blue (improvement via
 * increase) — direction of "good" depends on the metric, not the sign.
 */
interface Props {
  label: string;
  value: string;
  delta?: string;
  direction?: 'down' | 'up';
}

const { label, value, delta, direction = 'down' } = Astro.props;
---

<div class="panel metric">
  <div class="label">{label}</div>
  <div class="value">{value}</div>
  {delta && <div class={`delta ${direction}`}>{delta}</div>}
</div>

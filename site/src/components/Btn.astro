---
/**
 * Restrained button primitive — NOT a hero-sized SaaS CTA.
 * `primary` variant is reserved for the single contractor-card CTA
 * per the design-acceptance-gate anti-pattern rule.
 */
interface Props {
  href?: string;
  variant?: 'default' | 'primary';
  class?: string;
}

const { href, variant = 'default', class: className } = Astro.props;
const variantClass = variant === 'primary' ? 'btn primary' : 'btn';
const Tag = href ? 'a' : 'button';
---

<Tag class={[variantClass, className].filter(Boolean).join(' ')} href={href}>
  <slot />
</Tag>

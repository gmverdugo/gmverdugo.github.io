---
/**
 * Native 3-box flow diagram (source -> collector -> backend),
 * CSS/SVG boxes + connectors. Structural diagram — box labels are
 * the only data input, not metric-bound, so no hardcoded geometry
 * concern beyond evenly spacing 3 fixed boxes.
 */
interface Props {
  ariaLabel?: string;
  boxes?: [string, string, string];
}

const { ariaLabel = 'Flow diagram: telemetry source flows to collector, then to backend.', boxes = ['Source', 'Collector', 'Backend'] } = Astro.props;
---

<div class="chart-card otel-flow" role="img" aria-label={ariaLabel}>
  <div class="ch-title">Pipeline topology</div>
  <div class="flow">
    <div class="box">{boxes[0]}</div>
    <div class="connector" aria-hidden="true">
      <svg width="40" height="12" viewBox="0 0 40 12">
        <line x1="0" y1="6" x2="32" y2="6" stroke="#2e3953" stroke-width="2" />
        <path d="M28 1 L36 6 L28 11" fill="none" stroke="#2e3953" stroke-width="2" />
      </svg>
    </div>
    <div class="box">{boxes[1]}</div>
    <div class="connector" aria-hidden="true">
      <svg width="40" height="12" viewBox="0 0 40 12">
        <line x1="0" y1="6" x2="32" y2="6" stroke="#2e3953" stroke-width="2" />
        <path d="M28 1 L36 6 L28 11" fill="none" stroke="#2e3953" stroke-width="2" />
      </svg>
    </div>
    <div class="box">{boxes[2]}</div>
  </div>

  <table class="visually-hidden">
    <caption>{ariaLabel}</caption>
    <thead>
      <tr>
        <th scope="col">Step</th>
        <th scope="col">Stage</th>
      </tr>
    </thead>
    <tbody>
      {boxes.map((box, i) => <tr><th scope="row">{i + 1}</th><td>{box}</td></tr>)}
    </tbody>
  </table>
</div>

<style>
  .chart-card {
    background: var(--color-bg-1);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-base);
    padding: 16px;
  }
  .ch-title {
    font-size: 12px;
    color: var(--color-fg-1);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .flow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
  }
  .box {
    background: var(--color-bg-2);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm-base);
    padding: 14px 18px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-fg-0);
    text-align: center;
    min-width: 96px;
  }
  .connector {
    display: flex;
    align-items: center;
  }
</style>

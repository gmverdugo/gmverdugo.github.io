---
/**
 * Native 4-stage maturity tracker with a current-position marker.
 * Data-driven from `stages`/`current`/`max` — no hardcoded mockup
 * coordinates; marker position is computed as a percentage along
 * the track.
 */
interface Props {
  stages: string[];
  current: number;
  max: number;
  ariaLabel: string;
}

const { stages, current, max, ariaLabel } = Astro.props;
const markerPercent = Math.min(100, Math.max(0, (current / max) * 100));
---

<div class="chart-card maturity-tracker">
  <div class="ch-title">Maturity tracker</div>
  <div class="ch-sub">Native structural diagram. Current score: {current.toFixed(1)} / {max.toFixed(1)}.</div>

  <div class="track" role="img" aria-label={ariaLabel}>
    <div class="track-line"></div>
    <div class="marker" style={`left:${markerPercent}%`}>
      <span class="marker-dot"></span>
      <span class="marker-label">{current.toFixed(1)} / {max.toFixed(1)}</span>
    </div>
    <div class="stages">
      {
        stages.map((stage, i) => (
          <div class="stage" style={`left:${(i / (stages.length - 1)) * 100}%`}>
            <span class="stage-tick"></span>
            <span class="stage-label">{stage}</span>
          </div>
        ))
      }
    </div>
  </div>

  <table class="visually-hidden">
    <caption>{ariaLabel}</caption>
    <thead>
      <tr>
        <th scope="col">Stage</th>
        <th scope="col">Position</th>
      </tr>
    </thead>
    <tbody>
      {
        stages.map((stage, i) => (
          <tr>
            <th scope="row">{stage}</th>
            <td>{i + 1} of {stages.length}</td>
          </tr>
        ))
      }
      <tr>
        <th scope="row">Current score</th>
        <td>
          {current.toFixed(1)} / {max.toFixed(1)}
        </td>
      </tr>
    </tbody>
  </table>
</div>

<style>
  .chart-card {
    background: var(--color-bg-1);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-base);
    padding: 16px;
  }
  .ch-title {
    font-size: 12px;
    color: var(--color-fg-1);
    font-weight: 600;
  }
  .ch-sub {
    font-size: 11px;
    color: var(--color-fg-2);
    margin-bottom: 28px;
  }
  .track {
    position: relative;
    height: 64px;
    margin: 0 8px 12px;
  }
  .track-line {
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-line-strong);
  }
  .marker {
    position: absolute;
    top: 8px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-dim);
  }
  .marker-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-0);
    white-space: nowrap;
  }
  .stages {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
  }
  .stage {
    position: absolute;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .stage-tick {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-line-strong);
    margin-top: 6px;
  }
  .stage-label {
    font-size: 11px;
    color: var(--color-fg-2);
    white-space: nowrap;
  }
</style>

---
import { getLocale, counterpartPath, t } from '../i18n';

/**
 * Segmented pill `[ EN | ES ]` language switcher — static anchor links
 * (no client JS; this is a static site, locale switching is navigation,
 * not a toggle). Tokens-only styling (no new colors). Placement: hosted
 * inside Statusbar's row (design Decision 4).
 *
 * Accessibility (ui-ux-pro-max CRITICAL rules, non-negotiable):
 *  - `<nav aria-label>` wrapper names the control for screen readers.
 *  - `aria-current="true"` on the active locale segment.
 *  - Visible `:focus-visible` ring matching the site-wide focus style.
 *  - >=44px effective touch target via padding (segments render small
 *    text but the clickable box is enlarged).
 *  - `prefers-reduced-motion` respected on the color transition.
 *  - Active state is NOT color-only: it also gets `font-weight` + an
 *    underline, so it reads correctly without relying on hue alone.
 */
const locale = getLocale(Astro.url.pathname);
const counterpart = counterpartPath(Astro.url.pathname);
const s = t(locale);

const segments = [
  { code: 'en' as const, label: 'EN', href: locale === 'en' ? Astro.url.pathname : counterpart },
  { code: 'es' as const, label: 'ES', href: locale === 'es' ? Astro.url.pathname : counterpart },
];
---

<nav class="lang-switcher" aria-label={s.switcherLabel}>
  {
    segments.map((segment) => (
      <a
        href={segment.href}
        class={['lang-switcher-segment', locale === segment.code ? 'is-active' : undefined].filter(Boolean).join(' ')}
        aria-current={locale === segment.code ? 'true' : undefined}
      >
        {segment.label}
      </a>
    ))
  }
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line-strong);
    background: var(--color-bg-2);
    border-radius: var(--radius-sm-base);
    font-family: var(--font-mono);
    overflow: hidden;
  }

  .lang-switcher-segment {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 44px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-fg-2);
    text-decoration: none;
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .lang-switcher-segment:hover {
    color: var(--color-fg-0);
    text-decoration: none;
  }

  .lang-switcher-segment:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm-base);
  }

  /* Active state is not color-only: weight + underline carry the signal
     too, so it reads correctly for color-blind/low-vision users and in
     print/high-contrast modes. */
  .lang-switcher-segment.is-active {
    color: var(--color-fg-0);
    background: var(--color-bg-3);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher-segment {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .lang-switcher-segment {
      padding: 0 10px;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import ConsoleShell from '../../layouts/ConsoleShell.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Chip from '../../components/Chip.astro';

// EN-only site for now (Phase 2/Slice B) — filter to the en/ locale subfolder.
// `caseStudies` entries declare their own `slug` field in the JSON, which
// the glob loader uses as `entry.id` (overriding the path-derived id) —
// so locale must be read from `entry.filePath` here, not `entry.id`.
const caseStudies = await getCollection('caseStudies', (entry) => entry.filePath?.includes('/en/') ?? false);
const sorted = caseStudies.sort((a, b) => a.data.engagementId.localeCompare(b.data.engagementId));
---

<ConsoleShell title="Case Studies" breadcrumb="~/case-studies" description="Three non-conflatable engagements — each with its own verified figures.">
  <div class="eyebrow">Case Studies</div>
  <h1 class="cs-idx-h1">Three engagements. Each with its own verified figures.</h1>
  <p class="cs-idx-lede">
    No engagement's figures are blended with another's. Each card links to a full Challenge / Architecture /
    Implementation / Stack / Results / Lessons-learned breakdown.
  </p>

  <SectionLabel number="01" heading="Engagements" />
  <div class="cs-card-grid">
    {
      sorted.map((entry) => (
        <a class="cs-card panel" href={`/case-studies/${entry.data.slug}`}>
          <div class="panel-body">
            <div class="cs-card-head">
              <span class="num" style="color:var(--color-accent)">{entry.data.engagementId}</span>
              <Chip variant={entry.data.dataIntegrity === 'verified' ? 'real' : 'illustrative'}>
                {entry.data.dataIntegrity === 'verified' ? 'verified' : 'illustrative'}
              </Chip>
            </div>
            <h3>{entry.data.title}</h3>
            <p class="dim">{entry.data.summary}</p>
            <div class="cs-card-client meta">{entry.data.client}</div>
          </div>
        </a>
      ))
    }
  </div>
</ConsoleShell>

<style>
  .cs-idx-h1 {
    font-size: 21px;
    margin: 6px 0 6px;
  }
  .cs-idx-lede {
    color: var(--color-fg-1);
    max-width: 720px;
    margin: 0 0 22px;
  }
  .cs-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .cs-card {
    display: block;
    color: inherit;
  }
  .cs-card:hover {
    background: var(--color-bg-2);
    text-decoration: none;
  }
  .cs-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .cs-card h3 {
    font-size: 14px;
    margin: 0 0 6px;
    color: var(--color-fg-0);
  }
  .cs-card p {
    font-size: 12.5px;
    margin: 0 0 10px;
  }
  .cs-card-client {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .cs-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Diagram from '../../components/Diagram.astro';
import OtelFlow from '../../components/diagrams/OtelFlow.astro';
import MetricTile from '../../components/MetricTile.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const ilmPolicyHtml = `<span class="k">PUT</span> _ilm/policy/hot-rollover
{
  <span class="s">"policy"</span>: {
    <span class="s">"phases"</span>: {
      <span class="s">"hot"</span>:  { <span class="s">"actions"</span>: { <span class="s">"rollover"</span>: { <span class="s">"max_primary_shard_size"</span>: <span class="s">"50gb"</span>, <span class="s">"max_age"</span>: <span class="s">"7d"</span> } } },
      <span class="s">"warm"</span>: { <span class="s">"min_age"</span>: <span class="s">"7d"</span>, <span class="s">"actions"</span>: { <span class="s">"forcemerge"</span>: { <span class="s">"max_num_segments"</span>: 1 }, <span class="s">"set_priority"</span>: { <span class="s">"priority"</span>: 50 } } }
    }
  }
}
<span class="c"># warm-tier codec — recover storage without touching HOT latency</span>
<span class="k">PUT</span> warm-*/_settings
{ <span class="s">"index.codec"</span>: <span class="s">"best_compression"</span> }`;

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
// Widen to string so consecutive equality checks below (=== 'A', === 'B')
// are evaluated independently instead of TS narrowing the union across them.
const engagementId: string = data.engagementId;

const crumbsLabel = `CASE STUDY ${data.engagementId} · ${data.client.toUpperCase()} · ELASTICSEARCH`;
const breadcrumb = `~/case-studies/${data.slug}`;

const ariaLabelByType: Record<string, string> = {
  'bar-before-after': `Bar chart comparing before and after figures for ${data.title}.`,
  'maturity-tracker': `Maturity tracker showing a current score of ${data.diagram.data.current} out of ${data.diagram.data.max}.`,
  'consolidation-before-after': `Before/after diagram showing consolidation from ${data.diagram.data.before?.value} to ${data.diagram.data.after?.value}.`,
};

// Result tiles: render the first 4 verified metrics as panel tiles
// (matches mockup's 4-up result-tiles pattern for Case Study A; B/C
// have fewer metrics so fewer tiles render, which is correct — no
// padding with invented figures).
const resultTiles = data.metrics.slice(0, 4);

function tileDirection(metric: (typeof data.metrics)[number]): 'down' | 'up' {
  if (typeof metric.delta === 'string' && metric.delta.trim().startsWith('-')) return 'down';
  if (typeof metric.delta === 'string' && metric.delta.trim().startsWith('+')) return 'up';
  return 'down';
}

function tileValue(metric: (typeof data.metrics)[number]): string {
  if (metric.after !== undefined) return String(metric.after);
  if (metric.before !== undefined) return String(metric.before);
  return metric.delta ?? '';
}
---

<CaseStudyLayout
  breadcrumb={breadcrumb}
  crumbsLabel={crumbsLabel}
  title={data.title}
  dek={data.summary}
  tags={data.sections.stack}
  dataIntegrity={data.dataIntegrity}
>
  <section id="challenge">
    <h2>Challenge</h2>
    <p>{data.sections.challenge}</p>
  </section>

  <section id="architecture">
    <h2>Architecture</h2>
    <p>{data.sections.architecture}</p>
  </section>

  <section id="implementation">
    <h2>Implementation</h2>
    <p>{data.sections.implementation}</p>
    {engagementId === 'A' && <CodeBlock set:html={ilmPolicyHtml} />}
  </section>

  <section id="stack">
    <h2>Stack</h2>
    <div class="stack-row">
      {data.sections.stack.map((tech) => <span class="chip mono">{tech}</span>)}
    </div>
  </section>

  <section id="results">
    <h2>Results</h2>
    <div class="result-tiles">
      {
        resultTiles.map((metric) => (
          <MetricTile label={metric.label} value={tileValue(metric)} delta={metric.delta} direction={tileDirection(metric)} />
        ))
      }
    </div>

    <div style="margin-top:14px">
      <Diagram type={data.diagram.type as any} data={data.diagram.data} ariaLabel={ariaLabelByType[data.diagram.type] ?? data.title} />
    </div>

    {engagementId === 'B' && <div style="margin-top:14px"><OtelFlow ariaLabel="OpenTelemetry pipeline: source flows to collector, then to backend." /></div>}

    <p class="meta" style="margin-top:12px">{data.sections.results}</p>
  </section>

  <section id="lessons">
    <h2>Lessons learned</h2>
    <ul class="clean">
      {data.sections.lessons.map((lesson) => <li>{lesson}</li>)}
    </ul>
  </section>
</CaseStudyLayout>

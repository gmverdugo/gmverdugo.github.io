---
import ConsoleShell from '../layouts/ConsoleShell.astro';
import SectionLabel from '../components/SectionLabel.astro';

/**
 * Capability/skill map — Elastic Stack, OTel, K8s, SIEM/MITRE, ILM,
 * LogsDB, IaC presented as capability-layer content, not case
 * evidence (no per-engagement figures here; those live on the
 * Case Studies pages and the Overview engagement register).
 */
const domains = [
  {
    name: 'Elastic Stack',
    detail: 'Cluster architecture, sharding strategy, data-tier design (hot/warm/cold/frozen), Kibana operational dashboards.',
  },
  {
    name: 'Index Lifecycle Management',
    detail: 'Rollover policies, retention windows, guardrail templates applied across the index space to prevent regrowth.',
  },
  {
    name: 'LogsDB',
    detail: 'Storage-format migration for log-heavy workloads, reducing on-disk footprint without shortening retention.',
  },
  {
    name: 'OpenTelemetry',
    detail: 'Instrumentation strategy and collector topology — source, collector, and backend pipeline design.',
  },
  {
    name: 'SIEM & MITRE ATT&CK',
    detail: 'Detection rule lifecycle, MITRE-mapped coverage auditing, and impact-analysis process design.',
  },
  {
    name: 'Kubernetes & IaC',
    detail: 'Agent fleet rollout (Fleet/Elastic Agent), multi-tenant ingest patterns, Terraform/Ansible automation.',
  },
];
---

<ConsoleShell title="Architectures" breadcrumb="~/architectures" description="Capability map across the Elastic Stack, OpenTelemetry, SIEM, and infrastructure-as-code domains.">
  <div class="eyebrow">Architectures</div>
  <h1 class="arch-h1">Capability map — the architecture domains I design and operate within.</h1>
  <p class="arch-lede">
    This is a capability map, not case evidence: it describes domains of practice. Specific, attributed
    outcomes for each named engagement live on the Case Studies pages and the Overview engagement register.
  </p>

  <SectionLabel number="01" heading="Domains" />
  <div class="domain-grid">
    {
      domains.map((domain) => (
        <div class="domain-card panel">
          <div class="panel-body">
            <h3>{domain.name}</h3>
            <p>{domain.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
</ConsoleShell>

<style>
  .arch-h1 {
    font-size: 21px;
    margin: 6px 0 6px;
  }
  .arch-lede {
    color: var(--color-fg-1);
    max-width: 720px;
    margin: 0 0 22px;
  }
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .domain-card h3 {
    font-size: 13px;
    color: var(--color-fg-0);
    margin-bottom: 6px;
  }
  .domain-card p {
    font-size: 12.5px;
    color: var(--color-fg-2);
    margin: 0;
  }
  @media (max-width: 700px) {
    .domain-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import ConsoleShell from '../../layouts/ConsoleShell.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Chip from '../../components/Chip.astro';

// EN-only site for now (Phase 2/Slice B) — filter to the en/ locale subfolder.
const entries = await getCollection('labEntries', (entry) => entry.id.startsWith('en/'));
// Real snippets first, illustrative drafts after — surfaces verified
// work before placeholder material.
const sorted = [...entries].sort((a, b) => (a.data.status === b.data.status ? 0 : a.data.status === 'real' ? -1 : 1));
---

<ConsoleShell title="Lab" breadcrumb="~/lab" description="Working notes and snippets — a mix of real, verified material and illustrative drafts.">
  <div class="eyebrow">Lab</div>
  <h1 class="lab-h1">Working notes, snippets, and drafts.</h1>
  <p class="lab-lede">
    A mix of real, verified snippets pulled from actual engagement work and illustrative drafts exploring
    topics I haven't yet shipped. Each entry is chip-marked so it's never ambiguous which is which.
  </p>

  <SectionLabel number="01" heading="Entries" />
  <div class="lab-list">
    {
      sorted.map((entry) => (
        <a class="lab-row panel" href={`/lab/${entry.id.replace(/^en\//, '')}`}>
          <div class="panel-body">
            <div class="lab-row-head">
              <h3>{entry.data.title}</h3>
              <Chip variant={entry.data.status === 'real' ? 'real' : 'illustrative'}>{entry.data.status}</Chip>
            </div>
            <div class="lab-tags">
              {entry.data.tags.map((tag) => <span class="chip mono">{tag}</span>)}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</ConsoleShell>

<style>
  .lab-h1 {
    font-size: 21px;
    margin: 6px 0 6px;
  }
  .lab-lede {
    color: var(--color-fg-1);
    max-width: 720px;
    margin: 0 0 22px;
  }
  .lab-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .lab-row {
    display: block;
    color: inherit;
  }
  .lab-row:hover {
    background: var(--color-bg-2);
    text-decoration: none;
  }
  .lab-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .lab-row-head h3 {
    font-size: 14px;
    color: var(--color-fg-0);
  }
  .lab-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
</style>

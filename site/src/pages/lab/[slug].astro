---
import { getCollection } from 'astro:content';
import ConsoleShell from '../../layouts/ConsoleShell.astro';
import Chip from '../../components/Chip.astro';
import CodeBlock from '../../components/CodeBlock.astro';

export async function getStaticPaths() {
  // EN-only site for now (Phase 2/Slice B) — filter to the en/ locale
  // subfolder and strip the prefix from `entry.id` so the public slug
  // (and therefore the URL) stays identical to its pre-restructure value.
  const entries = await getCollection('labEntries', (entry) => entry.id.startsWith('en/'));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const isIllustrative = data.status === 'illustrative';
const slug = entry.id.replace(/^en\//, '');
---

<ConsoleShell title={data.title} breadcrumb={`~/lab/${slug}`} description={data.body} backHref="/lab" backLabel="Lab">
  <div class="eyebrow">Lab</div>
  <div class="lab-entry-head">
    <h1>{data.title}</h1>
    <Chip variant={isIllustrative ? 'illustrative' : 'real'}>{data.status}</Chip>
  </div>
  <div class="lab-tags">
    {data.tags.map((tag) => <span class="chip mono">{tag}</span>)}
  </div>

  {
    isIllustrative && (
      <p class="meta lab-draft-notice">
        This entry is an illustrative draft — it documents a direction I'm exploring, not a completed or
        published piece of work.
      </p>
    )
  }

  <p class="lab-body">{data.body}</p>

  {data.snippet && <CodeBlock set:text={data.snippet} />}
</ConsoleShell>

<style>
  .lab-entry-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0 10px;
  }
  .lab-entry-head h1 {
    font-size: 20px;
  }
  .lab-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .lab-draft-notice {
    margin-bottom: 16px;
  }
  .lab-body {
    color: var(--color-fg-1);
    max-width: 720px;
    margin: 0 0 18px;
  }
</style>

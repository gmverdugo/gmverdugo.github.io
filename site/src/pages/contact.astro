---
import ConsoleShell from '../layouts/ConsoleShell.astro';
import ContractorCard from '../components/ContractorCard.astro';
import Avatar from '../components/Avatar.astro';
import StatusDot from '../components/StatusDot.astro';
---

<ConsoleShell title="Contact" breadcrumb="~/contact" description="Independent contractor — remote-first, Mendoza AR, ES/EN.">
  <div class="eyebrow">Contact</div>
  <h1 class="contact-h1">Let's talk about your platform.</h1>
  <p class="contact-lede">
    Reach out for architecture advisory, platform assessments, or optimization programs. No agency, no
    intermediaries — direct engagement with the person doing the work.
  </p>

  <div class="contact-id panel">
    <div class="panel-body contact-id-body">
      <Avatar initials="GV" size="lg" />
      <div>
        <div class="contact-name">Gonzalo Verdugo</div>
        <div class="meta contact-role">Enterprise Observability Architect</div>
        <div class="contact-meta-row">
          <span><StatusDot variant="ok" /> Available · remote-first</span>
          <span class="meta">Mendoza, AR · ES / EN</span>
        </div>
      </div>
    </div>
  </div>

  <ContractorCard
    heading="Available for direct consulting engagements"
    body="Independent contractor — architecture advisory, platform assessments, and optimization programs. No agency, no intermediaries."
    ctaLabel="Email me"
    ctaHref="mailto:gonzalomartinverdugo@gmail.com"
  />
</ConsoleShell>

<style>
  .contact-h1 {
    font-size: 21px;
    margin: 6px 0 6px;
  }
  .contact-lede {
    color: var(--color-fg-1);
    max-width: 720px;
    margin: 0 0 22px;
  }
  .contact-id-body {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .contact-name {
    font-size: 15px;
    font-weight: 600;
  }
  .contact-role {
    margin-bottom: 8px;
  }
  .contact-meta-row {
    display: flex;
    gap: 16px;
    font-size: 12.5px;
    color: var(--color-fg-1);
  }
</style>
